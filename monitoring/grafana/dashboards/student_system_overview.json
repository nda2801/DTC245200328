{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "TỔNG QUAN TRẠNG THÁI HỆ THỐNG (EXECUTIVE OVERVIEW)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Trạng thái Web App",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "max(up{job=\"student_webapp\"})", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Trạng thái MySQL DB",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "max(up{job=\"mysqld_exporter\"})", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISCONNECTED", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Tổng số HTTP Requests",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(http_requests_total) or vector(0)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Tỷ lệ Lỗi HTTP (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "(sum(rate(http_requests_total{status=~\"[45]..\"}[2m])) / (sum(rate(http_requests_total[2m])) > 0) * 100) or vector(0)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Độ trễ P95 (Latency)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "(histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[2m])) by (le)) * 1000) or vector(0)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 100 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "id": 6,
      "title": "MySQL Threads Connected",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "max(mysql_global_status_threads_connected) or vector(0)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "HIỆU NĂNG ỨNG DỤNG WEB - MÔ HÌNH RED (RATE, ERRORS, DURATION)",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Tần suất Yêu cầu HTTP theo Route & Status (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (route, status)", "legendFormat": "{{route}} [{{status}}]", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": true } }
      }
    },
    {
      "id": 12,
      "title": "Độ trễ Phản hồi HTTP (P50, P90, P99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P50 (Median)", "refId": "A" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "P99", "refId": "C" }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true } }
      }
    },
    {
      "id": 13,
      "title": "Bộ nhớ Node.js V8 Heap Usage (MB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "(student_app_nodejs_heap_size_used_bytes{job=\"student_webapp\"} or nodejs_heap_size_used_bytes{job=\"student_webapp\"}) / 1048576", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "(student_app_nodejs_heap_size_total_bytes{job=\"student_webapp\"} or nodejs_heap_size_total_bytes{job=\"student_webapp\"}) / 1048576", "legendFormat": "Heap Total", "refId": "B" }
      ],
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      }
    },
    {
      "id": 14,
      "title": "Độ trễ Event Loop Node.js (Seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "(student_app_nodejs_eventloop_lag_seconds{job=\"student_webapp\"} or nodejs_eventloop_lag_seconds{job=\"student_webapp\"})", "legendFormat": "Event Loop Lag", "refId": "A" }
      ],
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 300,
      "title": "GIÁM SÁT HẠ TẦNG CONTAINER - MÔ HÌNH USE (CADVISOR)",
      "type": "row"
    },
    {
      "id": 21,
      "title": "Mức độ sử dụng CPU từng Container (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [{ "expr": "(sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) by (name) * 100) or (sum(rate(container_cpu_usage_seconds_total{id!=\"/\"}[1m])) by (id) * 100)", "legendFormat": "{{name}}{{id}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "fillOpacity": 10, "lineWidth": 2 } }
      }
    },
    {
      "id": 22,
      "title": "Bộ nhớ RAM tiêu thụ từng Container (MB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [{ "expr": "(sum(container_memory_working_set_bytes{name!=\"\"}) by (name) / 1048576) or (sum(container_memory_usage_bytes{id!=\"/\"}) by (id) / 1048576)", "legendFormat": "{{name}}{{id}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 400,
      "title": "HIỆU NĂNG CƠ SỞ DỮ LIỆU MYSQL (MYSQLD_EXPORTER)",
      "type": "row"
    },
    {
      "id": 31,
      "title": "Tần suất Truy vấn CSDL (Queries Per Second - QPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "targets": [{ "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "Queries/sec", "refId": "A" }],
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      }
    },
    {
      "id": 32,
      "title": "Tần suất Thao tác CRUD (Commands / sec)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 8, "y": 31 },
      "targets": [{ "expr": "rate(mysql_global_status_commands_total{command=~\"select|insert|update|delete\"}[1m])", "legendFormat": "{{command}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "id": 33,
      "title": "InnoDB Buffer Pool Utilization",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 31 },
      "targets": [{ "expr": "(mysql_global_status_innodb_buffer_pool_bytes_data / mysql_global_variables_innodb_buffer_pool_size) * 100", "refId": "A" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 500,
      "title": "NHẬT KÝ TẬP TRUNG THỜI GIAN THỰC (GRAFANA LOKI & LOGQL)",
      "type": "row"
    },
    {
      "id": 41,
      "title": "Luồng Nhật ký Hoạt động Hệ thống (Loki Live Stream)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 40 },
      "targets": [{ "expr": "{container=~\"student_webapp|nginx_proxy|student_mysql\"}", "refId": "A" }],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 42,
      "title": "Truy vết Kiểm toán & Cảnh báo Ngoại lệ (Audit & Error Logs)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 40 },
      "targets": [{ "expr": "{container=~\"student_webapp|nginx_proxy\"} |~ \"(?i)(audit|error|exception|failed|warn|http)\"", "refId": "A" }],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["student-management", "prometheus", "cadvisor", "mysql", "loki", "devops", "ictu"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Hệ thống Quản lý Sinh viên - Giám sát Toàn diện",
  "uid": "student-system-overview",
  "version": 2
}
