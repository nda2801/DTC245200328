<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1"><i class="fa-solid fa-users text-primary me-2"></i>Quản Lý Sinh Viên</h3>
    <p class="text-muted mb-0">Thực hiện đầy đủ nghiệp vụ CRUD: Thêm, Xem, Sửa, Xóa thông tin sinh viên</p>
  </div>
  <a href="/students/create" class="btn btn-primary">
    <i class="fa-solid fa-user-plus me-1"></i> Thêm Sinh Viên Mới
  </a>
</div>

<!-- Search Bar -->
<div class="card p-3 mb-4">
  <form action="/students" method="GET" class="row g-2 align-items-center">
    <div class="col-md-9">
      <div class="input-group">
        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
        <input type="text" name="q" value="<%= search %>" class="form-control" placeholder="Tìm theo Mã SV, Họ tên hoặc Email...">
      </div>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary flex-grow-1">Tìm kiếm</button>
      <% if (search) { %>
        <a href="/students" class="btn btn-outline-secondary">Đặt lại</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Students Table -->
<div class="card p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Mã SV</th>
          <th>Họ và Tên</th>
          <th>Ngày sinh</th>
          <th>Giới tính</th>
          <th>Email</th>
          <th>Số ĐT</th>
          <th>Lớp</th>
          <th>Trạng thái</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (students.length > 0) { %>
          <% students.forEach(s => { %>
            <tr>
              <td class="fw-bold text-primary"><%= s.student_code %></td>
              <td class="fw-semibold"><%= s.full_name %></td>
              <td><%= new Date(s.dob).toLocaleDateString('vi-VN') %></td>
              <td><%= s.gender %></td>
              <td><small class="text-muted"><%= s.email %></small></td>
              <td><%= s.phone || '-' %></td>
              <td><span class="badge bg-light text-dark border"><%= s.class_name || 'Chưa gán' %></span></td>
              <td>
                <% if (s.status === 'Đang học') { %>
                  <span class="badge bg-success">Đang học</span>
                <% } else if (s.status === 'Bảo lưu') { %>
                  <span class="badge bg-warning text-dark">Bảo lưu</span>
                <% } else if (s.status === 'Tốt nghiệp') { %>
                  <span class="badge bg-info text-dark">Tốt nghiệp</span>
                <% } else { %>
                  <span class="badge bg-danger"><%= s.status %></span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/students/edit/<%= s.id %>" class="btn btn-sm btn-outline-primary" title="Sửa">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>
                <form action="/students/delete/<%= s.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="9" class="text-center text-muted py-4">Không tìm thấy sinh viên nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
