<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h4 class="fw-bold mb-0">
          <i class="fa-solid fa-user-pen text-primary me-2"></i><%= student && student.id ? 'Cập Nhật Sinh Viên' : 'Thêm Sinh Viên Mới' %>
        </h4>
        <a href="/students" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
      </div>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i><%= errorMessage %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form action="<%= student && student.id ? '/students/edit/' + student.id : '/students/create' %>" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Mã số sinh viên (MSSV) <span class="text-danger">*</span></label>
            <input type="text" name="student_code" class="form-control" required
                   value="<%= student ? student.student_code : '' %>" placeholder="VD: DTC245200328">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
            <input type="text" name="full_name" class="form-control" required
                   value="<%= student ? student.full_name : '' %>" placeholder="VD: Nguyễn Văn An">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
            <input type="date" name="dob" class="form-control" required
                   value="<%= student && student.dob ? new Date(student.dob).toISOString().split('T')[0] : '' %>">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Giới tính</label>
            <select name="gender" class="form-select">
              <option value="Nam" <%= student && student.gender === 'Nam' ? 'selected' : '' %>>Nam</option>
              <option value="Nữ" <%= student && student.gender === 'Nữ' ? 'selected' : '' %>>Nữ</option>
              <option value="Khác" <%= student && student.gender === 'Khác' ? 'selected' : '' %>>Khác</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
            <input type="email" name="email" class="form-control" required
                   value="<%= student ? student.email : '' %>" placeholder="VD: an.nguyen@student.edu.vn">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Số điện thoại</label>
            <input type="text" name="phone" class="form-control"
                   value="<%= student ? student.phone : '' %>" placeholder="VD: 0912345678">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Lớp học</label>
            <select name="class_id" class="form-select">
              <option value="">-- Chọn lớp học --</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= student && student.class_id == c.id ? 'selected' : '' %>>
                  <%= c.class_name %> (<%= c.class_code %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Trạng thái học tập</label>
            <select name="status" class="form-select">
              <option value="Đang học" <%= !student || student.status === 'Đang học' ? 'selected' : '' %>>Đang học</option>
              <option value="Bảo lưu" <%= student && student.status === 'Bảo lưu' ? 'selected' : '' %>>Bảo lưu</option>
              <option value="Tốt nghiệp" <%= student && student.status === 'Tốt nghiệp' ? 'selected' : '' %>>Tốt nghiệp</option>
              <option value="Đình chỉ" <%= student && student.status === 'Đình chỉ' ? 'selected' : '' %>>Đình chỉ</option>
            </select>
          </div>

          <div class="col-12 mt-4 text-end">
            <a href="/students" class="btn btn-secondary me-2">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
