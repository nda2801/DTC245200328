<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h4 class="fw-bold mb-0">
          <i class="fa-solid fa-calculator text-primary me-2"></i><%= grade && grade.id ? 'Cập Nhật Điểm Sinh Viên' : 'Nhập Điểm Mới' %>
        </h4>
        <a href="/grades" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
      </div>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fa-solid fa-circle-exclamation me-2"></i><%= errorMessage %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form action="<%= grade && grade.id ? '/grades/edit/' + grade.id : '/grades/create' %>" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Sinh viên <span class="text-danger">*</span></label>
            <select name="student_id" class="form-select" required>
              <option value="">-- Chọn sinh viên --</option>
              <% students.forEach(s => { %>
                <option value="<%= s.id %>" <%= grade && grade.student_id == s.id ? 'selected' : '' %>>
                  <%= s.student_code %> - <%= s.full_name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Môn học <span class="text-danger">*</span></label>
            <select name="subject_id" class="form-select" required>
              <option value="">-- Chọn môn học --</option>
              <% subjects.forEach(sub => { %>
                <option value="<%= sub.id %>" <%= grade && grade.subject_id == sub.id ? 'selected' : '' %>>
                  <%= sub.subject_code %> - <%= sub.subject_name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Điểm chuyên cần (10%) <span class="text-danger">*</span></label>
            <input type="number" step="0.1" min="0" max="10" name="attendance_score" class="form-control" required
                   value="<%= grade ? grade.attendance_score : 10 %>">
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Điểm giữa kỳ (30%) <span class="text-danger">*</span></label>
            <input type="number" step="0.1" min="0" max="10" name="midterm_score" class="form-control" required
                   value="<%= grade ? grade.midterm_score : 8 %>">
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Điểm cuối kỳ (60%) <span class="text-danger">*</span></label>
            <input type="number" step="0.1" min="0" max="10" name="final_score" class="form-control" required
                   value="<%= grade ? grade.final_score : 8 %>">
          </div>

          <div class="col-md-12">
            <label class="form-label fw-semibold">Học kỳ</label>
            <input type="text" name="semester" class="form-control"
                   value="<%= grade ? grade.semester : 'Học kỳ 1 - 2026' %>">
          </div>

          <div class="col-12 mt-4 text-end">
            <a href="/grades" class="btn btn-secondary me-2">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-floppy-disk me-1"></i> Lưu điểm
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
