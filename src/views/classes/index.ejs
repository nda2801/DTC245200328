<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1"><i class="fa-solid fa-chalkboard text-primary me-2"></i>Quản Lý Lớp Học</h3>
    <p class="text-muted mb-0">Danh sách các lớp niên khóa, khoa đào tạo và sĩ số sinh viên</p>
  </div>
  <a href="/classes/create" class="btn btn-primary">
    <i class="fa-solid fa-plus me-1"></i> Thêm Lớp Mới
  </a>
</div>

<div class="card p-3">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Mã Lớp</th>
          <th>Tên Lớp</th>
          <th>Khoa / Viện</th>
          <th>Niên khóa</th>
          <th>Sĩ số</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (classes.length > 0) { %>
          <% classes.forEach(c => { %>
            <tr>
              <td class="fw-bold text-primary"><%= c.class_code %></td>
              <td class="fw-semibold"><%= c.class_name %></td>
              <td><%= c.faculty %></td>
              <td><span class="badge bg-light text-dark border"><%= c.academic_year %></span></td>
              <td>
                <span class="badge bg-primary rounded-pill"><%= c.student_count %> SV</span>
              </td>
              <td class="text-end">
                <a href="/classes/edit/<%= c.id %>" class="btn btn-sm btn-outline-primary" title="Sửa">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>
                <form action="/classes/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp này?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4">Chưa có lớp học nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
